# ReviewLens — Environment Variables

# Server
PORT=5000

# MongoDB — use MongoDB Atlas URI for production
# Get free cluster at: https://cloud.mongodb.com
MONGODB_URI=mongodb://localhost:27017/reviewlens
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/reviewlens

# Groq AI API — get free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Environment
NODE_ENV=development

# JWT Secret — change this in production!
JWT_SECRET=change_this_to_a_secure_random_string_in_production
